<pp-weather>
    <pp-weather-inner>
        <pp-weather-front>
            <pp-weather-icons>
            </pp-weather-icons>
            <pp-weather-city>
                <p class="city-label">city</p>
                <p class="city-value"></p>
            </pp-weather-city>
            <pp-weather-temp>
                <p class="temp-label">temperature</p>
                <p class="temp-value"></p>
            </pp-weather-temp>
            <pp-weather-humid>
                <p class="humid-label">humidity</p>
                <p class="humid-value"></p>
            </pp-weather-humid>
        </pp-weather-front>
        <pp-weather-back>
            <weather-forecast-container>

            </weather-forecast-container>
            
        </pp-weather-back>
    </pp-weather-inner>
</pp-weather>

<pp-weather-loader-container>
    <pp-loader>
        <pp-loader-dot />
        <pp-loader-dot />
        <pp-loader-dot />
        <pp-loader-dot />
    </pp-loader>
</pp-weather-loader-container>

<pp-weather-error-container>
    <p class="error-notification">API Error</p>
    <p class="weather-error-code"></p>
</pp-weather-error-container>